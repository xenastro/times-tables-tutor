{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ashra",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ashra-db",
      "database_id": "e43a2a55-2e97-4814-a9f6-becedbb199cf",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [{ "pattern": "ashra.aburaddad.com", "custom_domain": true }],
  "vars": {
    "RP_ID": "ashra.aburaddad.com",
    "ORIGINS": "https://ashra.aburaddad.com",
    // Turnstile widget "Ashra" (public key; the secret is the Worker secret TURNSTILE_SECRET).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFTHrLaaN3rEMzZv"
  },
  // Nightly clean-up: children nobody connected (see /privacy) and expired sign-in leftovers.
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}
